# Claude via AWS Bedrock (default provider). Credentials come from your AWS SSO
# profile; run `aws sso login --profile <profile>` before long runs.
AWS_PROFILE='bedrock'
AWS_REGION='us-east-1'

# Only needed for -m gemini / -m gpt
GEMINI_API_KEY='YOUR_GEMINI_API_KEY_HERE'
OPENAI_API_KEY='YOUR_OPENAI_API_KEY_HERE'

# Optional overrides (defaults shown)
# CLAUDE_MODEL='us.anthropic.claude-haiku-5-5'
# CLAUDE_EFFORT='low'
# GEMINI_MODEL='gemini-3.8-flash'
# GEMINI_THINKING_LEVEL='low'
# GEMINI_MIN_INTERVAL='4'   # seconds between Gemini calls; 0 on a paid tier
# GPT_MODEL='gpt-6-luna'
# GPT_REASONING_EFFORT='low'
